#!/bin/sh
# Slim image services, spawned by PID1 after USB ADB setup. Network first, then
# the persistent Alpine tree on data; SSH runs from Alpine with its persistent
# host key. If data is absent, wrong or fails to activate, nothing else starts:
# PID1 and authenticated USB ADB stay available (plan B4).
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
say() { echo "mibox-slim: $*" > /dev/kmsg 2>/dev/null || true; echo "$*"; }
mkdir -p /dev/pts /run
if ! grep -q ' /dev/pts devpts ' /proc/mounts; then
    mount -t devpts -o nosuid,noexec devpts /dev/pts
fi
if [ -e /dev/pts/ptmx ]; then
    chmod 666 /dev/pts/ptmx
    ln -sf pts/ptmx /dev/ptmx
fi
if [ ! -e /dev/tty ]; then mknod -m 666 /dev/tty c 5 0; fi
chmod 1777 /tmp
ip link set lo up
qemu=
# Only the QEMU virt fixture uses DHCP. The physical LAN retains the
# owner-confirmed static profile, without enabling a DHCP client.
if grep -aq 'linux,dummy-virt' /proc/device-tree/compatible 2>/dev/null; then
    qemu=--qemu
    ip link set eth0 up
    udhcpc -i eth0 -n -q -t 5 -T 2 -s /etc/mibox-udhcpc
elif grep -q '^MIBOX_STATIC_IPV4_V1 192.168.1.222 255.255.255.0 192.168.1.1$' /etc/mibox-network-static; then
    ip link set eth0 up
    ip addr add 192.168.1.222/24 dev eth0
    ip route add default via 192.168.1.1
else
    say MIBOX_NETWORK_PROFILE_INVALID
fi
# Host-independent time (plan B3). The RTC only counts since cold power-on,
# so the clock starts in 1970: NTP (verified reachable from the owner LAN) is
# the only source. State in /run/mibox-time-state; UNSYNCHRONIZED until the
# first success, then resynchronized every 6 hours. The RTC is never written.
echo UNSYNCHRONIZED > /run/mibox-time-state
(
    trap '' HUP
    delay=15
    while :; do
        if ntpd -n -q -p pool.ntp.org -p time.cloudflare.com > /run/mibox-ntpd.log 2>&1; then
            echo "SYNCED $(date -u +%Y-%m-%dT%H:%M:%SZ)" > /run/mibox-time-state
            echo "mibox-slim: MIBOX_TIME_SYNCED $(date -u +%Y-%m-%dT%H:%M:%SZ)" > /dev/kmsg 2>/dev/null
            sleep 21600
            delay=15
        else
            sleep "$delay"
            [ "$delay" -lt 300 ] && delay=$((delay * 2))
        fi
    done
) < /dev/null > /dev/null 2>&1 &
# HDMI status splash (plan A5). Only on a flash boot does the bootloader run
# init_display and load the HDCP keys; a C003-intercepted boot leaves HDMI
# muted. The handoff verifies fb0 is 1280x1080x32 with R/G/B/A at bit offsets
# 0/8/16/24, so the opaque RGBA splash is copied straight into fb0, then the
# OSD scaler stretches it to the output mode (both verified on the box).
if [ -x /sbin/mibox-fbhandoff ] && [ -e /etc/mibox-splash.rgba ]; then
    (
        if /sbin/mibox-fbhandoff > /run/mibox-fbhandoff.log 2>&1; then
            dd if=/etc/mibox-splash.rgba of=/dev/fb0 bs=5120 count=1080 2>/dev/null
            g=/sys/class/graphics/fb0
            case "$(cat /sys/class/display/mode 2>/dev/null)" in
            1080p*) window='0 0 1919 1079' ;;
            720p*) window='0 0 1279 719' ;;
            *) window= ;;
            esac
            if [ -n "$window" ] && [ -w "$g/free_scale" ]; then
                echo '0 0 1279 1079' > "$g/free_scale_axis"
                echo "$window" > "$g/window_axis"
                echo 1 > "$g/free_scale"
            fi
            say "MIBOX_SPLASH_SHOWN window=${window:-unscaled}"
            # Live status screen (clock, cards, kernel log) replaces the
            # splash; if it exits with an error the splash is copied back.
            # Local time is UTC+8.
            if [ -x /sbin/mibox-fbstatus ]; then
                TZ=CST-8 /sbin/mibox-fbstatus > /run/mibox-fbstatus.log 2>&1
                status=$?
                if [ "$status" -ne 0 ]; then
                    dd if=/etc/mibox-splash.rgba of=/dev/fb0 bs=5120 count=1080 2>/dev/null
                    say "MIBOX_FBSTATUS_FAILED status=$status"
                fi
            fi
        else
            say MIBOX_SPLASH_HANDOFF_FAILED
        fi
    ) &
fi
if ! /sbin/mibox-persistent-console start --boot $qemu > /run/mibox-persistent-start.log 2>&1; then
    say MIBOX_PERSISTENT_UNAVAILABLE
    exit 0
fi
rm -f /run/mibox-alpine.stop
# PID1 supervises Alpine's dropbear from here on (plan B3): it starts and
# restarts it while this marker exists and the stop marker does not.
echo ready > /run/mibox-alpine-ready
say MIBOX_ALPINE_SSH_STARTING
# Docker engine: container kernel and owner opt-in only (see mibox-docker).
if [ -x /sbin/mibox-docker ]; then
    ( trap '' HUP; /sbin/mibox-docker supervise > /run/mibox-docker.log 2>&1 < /dev/null ) &
fi
