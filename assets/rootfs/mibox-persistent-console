#!/bin/sh
# Persistent Alpine lifecycle on the data partition.
#   start [--qemu]          host launcher on a full RAM console (RAM dropbear):
#                           may create the tree, switches RAM root's shell.
#   start --boot [--qemu]   slim image at boot (dropbear runs in Alpine): never
#                           creates the tree; undoes its mounts on any failure.
#   stop [--qemu]           kills every process rooted in the tree (SSH sessions
#                           included), then unmounts. A busy unmount fails and
#                           leaves data mounted, so the PID1 restart guard holds.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
test "$(id -u)" = 0
grep -q '^ID=mibox-custom$' /etc/os-release
store=/mnt/mibox-data
home=$store/mibox-console
root=$home/rootfs
device=/dev/mibox-data
expected=179:11
# Data free-space floor (plan S4, from the S1/S3 inventory): keep 256 MiB free.
floor_kib=262144
action=${1:-}
qemu=
boot=
shift || true
for flag in "$@"; do
    case "$flag" in
    --qemu) qemu=1 ;;
    --boot) boot=1 ;;
    *) echo "unknown flag: $flag" >&2; exit 2 ;;
    esac
done
# stdout may be a dead SSH session during stop; the kernel log always records.
kmsg() { echo "mibox-persistent: $*" > /dev/kmsg 2>/dev/null || true; echo "$*" 2>/dev/null || true; }
unmount_all() {
    for path in dev/pts dev proc sys; do
        if mountpoint -q "$root/$path"; then umount "$root/$path"; fi
    done
    if mountpoint -q "$store"; then umount "$store"; fi
}
if [ -n "$qemu" ]; then
    grep -aq 'linux,dummy-virt' /proc/device-tree/compatible
    device=/dev/vda
    expected=$(cat /sys/class/block/vda/dev)
else
    grep -aq 'AMLOGIC,8726_MX' /proc/device-tree/compatible
    test "$(cat /sys/class/block/data/dev)" = 179:11
    test "$(cat /sys/class/block/data/size)" = 5168640
    test "$(cat /sys/class/block/data/ro)" = 0
    if [ ! -e "$device" ]; then mknod -m 600 "$device" b 179 11; fi
    test ! -L "$device"
    test -b "$device"
    test "$(stat -c '%t:%T' "$device")" = b3:b
fi

case "$action" in
start)
    if [ -n "$boot" ]; then
        # Partial failure: undo binds and the data mount, start nothing.
        trap 'status=$?; if [ "$status" -ne 0 ]; then cd /; unmount_all || true; kmsg "MIBOX_PERSISTENT_BOOT_FAILED status=$status"; fi' EXIT
    fi
    mkdir -p "$store"
    test ! -L "$store"
    mounted=$(awk -v dev="$expected" '$3 == dev {print $5}' /proc/self/mountinfo)
    if [ -n "$mounted" ] && [ "$mounted" != "$store" ]; then
        echo 'Data is already mounted elsewhere; refusing' >&2
        exit 1
    fi
    if [ -z "$mounted" ]; then
        blkid "$device" | grep -q 'TYPE="ext4"'
        mount -t ext4 -o nosuid,nodev "$device" "$store"
    fi
    if [ -n "$boot" ]; then
        # The slim image has no package tools to seed a tree from: require one.
        test -d "$home" ; test ! -L "$home" ; test -d "$root"
    fi
    if [ ! -e "$home" ]; then mkdir -m 700 "$home"; fi
    test -d "$home" ; test ! -L "$home"
    test "$(stat -c '%u:%a' "$home")" = 0:700
    if [ ! -e "$root" ]; then
        available=$(df -Pk "$store" | awk 'END {print $4}')
        test "$available" -ge "$floor_kib"
        stage=$home/rootfs.initializing
        test ! -e "$stage"
        mkdir -m 700 "$stage"
        cp -a /bin /etc /lib /root /sbin /usr /var "$stage/"
        mkdir -p "$stage/dev" "$stage/proc" "$stage/sys" "$stage/tmp" "$stage/run"
        chmod 1777 "$stage/tmp"
        echo MIBOX_PERSISTENT_CONSOLE_V1 > "$stage/etc/mibox-persistent-root"
        mv "$stage" "$root"
        sync
    fi
    test -d "$root" ; test ! -L "$root"
    test "$(stat -c '%u:%a' "$root")" = 0:700
    grep -qx MIBOX_PERSISTENT_CONSOLE_V1 "$root/etc/mibox-persistent-root"
    grep -q '^ID=mibox-custom$' "$root/etc/os-release"
    for path in dev proc sys; do
        if ! mountpoint -q "$root/$path"; then mount -o bind "/$path" "$root/$path"; fi
    done
    if ! mountpoint -q "$root/dev/pts"; then mount -o bind /dev/pts "$root/dev/pts"; fi
    chroot "$root" /sbin/apk info -e dropbear
    # Package changes go through a guard that refuses them below the floor.
    # Rewritten on every start; /sbin/apk itself is unchanged.
    mkdir -p "$root/usr/local/sbin"
    test ! -L "$root/usr/local" ; test ! -L "$root/usr/local/sbin"
    guard=$root/usr/local/sbin/apk
    test ! -L "$guard"
    cat > "$guard.new" <<'APKGUARD'
#!/bin/sh
# MIBOX_APK_GUARD_V1: refuse package changes when / is below the free-space
# floor (plan S4). Read-only apk commands pass through. Bypass: /sbin/apk.
floor_kib=262144
sub=
skip=
for arg in "$@"; do
    if [ -n "$skip" ]; then skip=; continue; fi
    case "$arg" in
    -X|--repository|-p|--root|--arch|--cache-dir|--keys-dir|--repositories-file|\
    --progress-fd|--timeout|--cache-max-age) skip=1 ;;
    -*) ;;
    *) sub=$arg; break ;;
    esac
done
case "$sub" in
add|upgrade|fix|update) ;;
*) exec /sbin/apk "$@" ;;
esac
# statfs via `stat -f` needs no mount table; BusyBox df fails inside this chroot.
available=$(stat -f -c '%a %S' / 2>/dev/null | awk 'NF == 2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {printf "%d", $1 * $2 / 1024}')
case "$available" in
''|*[!0-9]*) echo "apk guard: cannot read free space on /; refusing $sub" >&2; exit 75 ;;
esac
if [ "$available" -lt "$floor_kib" ]; then
    echo "apk guard: / has $available KiB free, below the $floor_kib KiB floor; refusing $sub" >&2
    exit 75
fi
exec /sbin/apk "$@"
APKGUARD
    chmod 755 "$guard.new"
    mv "$guard.new" "$guard"
    # Backstop independent of PATH (non-interactive SSH, scripts): apk aborts a
    # transaction when a pre-commit hook fails (verified on the box, exit 99).
    # apk gives hooks no transaction details and a cleared environment, so a
    # deliberate owner-created file allows below-floor commits (e.g. apk del).
    hooks=$root/etc/apk/commit_hooks.d
    mkdir -p "$hooks"
    test ! -L "$root/etc/apk" ; test ! -L "$hooks"
    hook=$hooks/mibox-floor.sh
    test ! -L "$hook"
    cat > "$hook.new" <<'APKHOOK'
#!/bin/sh
# MIBOX_APK_FLOOR_HOOK_V1 (plan S4). Pre-commit: fail below the data floor
# unless /etc/apk/mibox-allow-below-floor exists. Other phases: no action.
floor_kib=262144
[ "${1:-}" = pre-commit ] || exit 0
if [ -e /etc/apk/mibox-allow-below-floor ]; then
    echo "apk floor hook: below-floor commits allowed by /etc/apk/mibox-allow-below-floor" >&2
    exit 0
fi
available=$(stat -f -c '%a %S' / 2>/dev/null | awk 'NF == 2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {printf "%d", $1 * $2 / 1024}')
case "$available" in
''|*[!0-9]*) echo "apk floor hook: cannot read free space on /; refusing commit" >&2; exit 1 ;;
esac
if [ "$available" -lt "$floor_kib" ]; then
    echo "apk floor hook: / has $available KiB free, below the $floor_kib KiB floor; refusing commit." >&2
    echo "To free space with apk del, create /etc/apk/mibox-allow-below-floor, then remove it." >&2
    exit 1
fi
exit 0
APKHOOK
    chmod 755 "$hook.new"
    mv "$hook.new" "$hook"
    available=$(df -Pk "$store" | awk 'END {print $4}')
    if [ -n "$boot" ]; then
        key=$root/etc/dropbear/dropbear_ed25519_host_key
        test -s "$key" ; test ! -L "$key" ; test "$(stat -c '%u:%a' "$key")" = 0:600
        test -s "$key.pub" ; test ! -L "$key.pub"
        test -x "$root/usr/sbin/dropbear"
        test -s "$root/root/.ssh/authorized_keys"
        # USB ADB (uid 2000) cannot read data; publish the public key in RAM so
        # the host can authenticate the persistent SSH identity over USB.
        mkdir -p /etc/dropbear
        cp "$key.pub" /etc/dropbear/dropbear_ed25519_host_key.pub.new
        chmod 644 /etc/dropbear/dropbear_ed25519_host_key.pub.new
        mv /etc/dropbear/dropbear_ed25519_host_key.pub.new /etc/dropbear/dropbear_ed25519_host_key.pub
        trap - EXIT
        kmsg "MIBOX_PERSISTENT_BOOT_READY free_kib=$available floor_kib=$floor_kib"
        if [ "$available" -lt "$floor_kib" ]; then kmsg MIBOX_DATA_BELOW_FLOOR; fi
        exit 0
    fi
    cat > /sbin/mibox-persistent-shell <<'SHELL'
#!/bin/sh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export SHELL=/bin/ash HOME=/root
if [ "$#" -eq 0 ]; then set -- -l; fi
exec /usr/sbin/chroot /mnt/mibox-data/mibox-console/rootfs /bin/ash "$@"
SHELL
    chmod 755 /sbin/mibox-persistent-shell
    if ! grep -qx /sbin/mibox-persistent-shell /etc/shells; then
        echo /sbin/mibox-persistent-shell >> /etc/shells
    fi
    # Only the RAM account changes. The disk account retains its Alpine shell.
    sed -i 's|^root:\([^:]*:[^:]*:[^:]*:[^:]*:[^:]*:\).*|root:\1/sbin/mibox-persistent-shell|' /etc/passwd
    echo MIBOX_PERSISTENT_CONSOLE_READY
    df -Pk "$store"
    echo "MIBOX_DATA_FREE_KIB=$available FLOOR_KIB=$floor_kib"
    # Below the floor the console still starts (recovery needs it); apk refuses.
    if [ "$available" -lt "$floor_kib" ]; then echo MIBOX_DATA_BELOW_FLOOR >&2; fi
    ;;
stop)
    # Must run with a RAM root (e.g. `chroot /proc/1/root ...`): it kills every
    # process rooted in the tree, which can include the caller's SSH session.
    test "$(readlink /proc/self/root)" = /
    trap '' HUP PIPE
    if [ -f /run/mibox-alpine-supervisor.pid ]; then
        touch /run/mibox-alpine.stop
        kill "$(cat /run/mibox-alpine-supervisor.pid)" 2>/dev/null || true
    fi
    rooted() {
        for p in /proc/[0-9]*; do
            if [ "$(readlink "$p/root" 2>/dev/null)" = "$root" ]; then echo "${p#/proc/}"; fi
        done
    }
    for signal in TERM TERM TERM KILL KILL; do
        pids=$(rooted)
        [ -z "$pids" ] && break
        kill -s "$signal" $pids 2>/dev/null || true
        sleep 1
    done
    pids=$(rooted)
    if [ -n "$pids" ]; then kmsg "MIBOX_PERSISTENT_STOP_BUSY pids=$pids"; exit 1; fi
    if grep -q '/sbin/mibox-persistent-shell$' /etc/passwd; then
        sed -i 's|/sbin/mibox-persistent-shell$|/bin/ash|' /etc/passwd
    fi
    sync
    if ! unmount_all; then kmsg MIBOX_PERSISTENT_STOP_UNMOUNT_FAILED; exit 1; fi
    rm -f /run/mibox-alpine-supervisor.pid /etc/dropbear/dropbear_ed25519_host_key.pub
    kmsg MIBOX_PERSISTENT_CONSOLE_STOPPED
    ;;
*) echo 'Usage: mibox-persistent-console start|stop [--boot] [--qemu]' >&2; exit 2 ;;
esac
