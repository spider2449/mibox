#!/bin/sh
# Runs as PID1 in a private mount/PID/network namespace, inside a RAM chroot.
set -eu
export PATH=/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin
export HOME=/root DOCKER_HOST=unix:///run/mibox-docker-test/docker.sock
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec,ro sysfs /sys
mount -t tmpfs -o mode=755,nosuid tmpfs /dev
for node in 'null 1 3' 'zero 1 5' 'random 1 8' 'urandom 1 9' 'tty 5 0'; do
    set -- $node
    mknod -m 666 /dev/"$1" c "$2" "$3"
done
mkdir -p /dev/pts /dev/shm /run/mibox-docker-test /sys/fs/cgroup
mount -t devpts -o newinstance,ptmxmode=0666,mode=620 devpts /dev/pts
ln -s pts/ptmx /dev/ptmx
ln -s /proc/self/fd /dev/fd
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
mount -t tmpfs -o mode=755,nosuid,nodev,noexec tmpfs /sys/fs/cgroup
awk '!/^#/ && $4 == 1 {print $1}' /proc/cgroups | while read -r controller; do
    mkdir /sys/fs/cgroup/"$controller"
    mount -t cgroup -o "$controller",nosuid,nodev,noexec cgroup /sys/fs/cgroup/"$controller"
done
ip link set lo up
echo MIBOX_DOCKER_PRIVATE_ENVIRONMENT
cat /proc/sys/kernel/osrelease /proc/self/cgroup /proc/mounts
daemon=
cleanup() {
    if [ -n "$daemon" ]; then
        kill -TERM "$daemon" 2>/dev/null || true
        n=0
        while kill -0 "$daemon" 2>/dev/null && [ "$n" -lt 20 ]; do
            sleep 1
            n=$((n + 1))
        done
        kill -KILL "$daemon" 2>/dev/null || true
        wait "$daemon" 2>/dev/null || true
    fi
    echo MIBOX_DOCKER_NAMESPACE_EXIT
}
trap cleanup EXIT
trap 'exit 124' TERM INT
dockerd --config-file /etc/docker/daemon.json > /tmp/dockerd.log 2>&1 &
daemon=$!
n=0
until docker info > /tmp/docker-info.txt 2>&1; do
    if ! kill -0 "$daemon" 2>/dev/null || [ "$n" -ge 60 ]; then
        cat /tmp/dockerd.log /tmp/docker-info.txt
        exit 1
    fi
    sleep 1
    n=$((n + 1))
done
echo MIBOX_DOCKER_DAEMON_READY
cat /tmp/docker-info.txt
docker version
image=$(docker import --platform linux/arm/v7 /opt/test-rootfs.tar mibox-offline:experiment)
echo "IMPORTED_IMAGE=$image"
docker run --name mibox-offline --network none --memory 32m --cpus 0.5 --init "$image" /bin/sh -c '
    set -eu
    echo MIBOX_CONTAINER_RUNNING
    grep -Eq "^Seccomp:[[:space:]]+2$" /proc/self/status
    echo DEFAULT_SECCOMP_PASS
    echo volume-proof > /tmp/proof
    sleep 120
' > /tmp/container.log 2>&1 &
client=$!
n=0
until grep -q DEFAULT_SECCOMP_PASS /tmp/container.log; do
    if ! kill -0 "$client" 2>/dev/null || [ "$n" -ge 30 ]; then
        cat /tmp/dockerd.log /tmp/container.log
        exit 1
    fi
    sleep 1
    n=$((n + 1))
done
docker exec mibox-offline /bin/sh -c 'test "$(cat /tmp/proof)" = volume-proof; echo CONTAINER_EXEC_PASS; cat /proc/self/cgroup'
docker inspect mibox-offline
docker logs mibox-offline
docker stop --time 5 mibox-offline
wait "$client" || true
docker rm mibox-offline
echo MIBOX_DOCKER_OFFLINE_TEST_PASS
