# The public BSP's OSD driver uses these symbols without selecting SW_SYNC.
# Keep HDMI/OSD rather than disabling display to work around a link failure.
CONFIG_SYNC=y
CONFIG_SW_SYNC=y
# The stock kernel has MTD disabled and this box uses eMMC. Do not accept
# the public BSP's newly introduced, default-enabled raw NAND drivers.
CONFIG_AM_NAND=n
CONFIG_AML_NEXT_NAND=n
CONFIG_MTD=n
